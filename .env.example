# Database (matches docker-compose postgres)
DATABASE_URL="postgresql://rentacar:rentacar@localhost:5432/rentacar?schema=public"

# Auth
JWT_SECRET="your-secret-key-change-in-production"

# App
NODE_ENV=development
PORT=3333
# APP_TIMEZONE=Asia/Bangkok

# S3 / Minio (optional — for local dev use docker profile: docker compose --profile with-minio up -d)
# S3_ENDPOINT=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=rentacar

# AI Chat (optional — get key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
